# PostgreSQL. Замените CHANGE_ME на длинный URL-safe пароль.
DATABASE_URL=postgres://mygame:CHANGE_ME@127.0.0.1:5432/mygame

# Express отдаёт фронтенд и API на одном порту.
PORT=8080
HOST=0.0.0.0

SAVE_ID=local
DEEPSEEK_API_KEY=

# Не нужно для same-origin production. Можно указать URL внешнего фронтенда.
# CORS_ORIGIN=https://game.example.com
