{
  "name": "mygame",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,api -c green,blue \"vite\" \"node server/index.js\"",
    "dev:web": "vite",
    "dev:api": "node server/index.js",
    "build": "vite build --outDir dist.next --emptyOutDir && node tools/stash-sourcemaps.mjs dist.next && node tools/publish-dist.mjs",
    "start": "NODE_ENV=production node server/index.js",
    "deploy:pm2": "npm run build && pm2 startOrReload ecosystem.config.cjs --env production",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "npm run lint:labels && eslint .",
    "lint:labels": "node tools/check-raw-labels.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@types/lz-string": "^1.3.34",
    "@types/seedrandom": "^3.0.8",
    "break_eternity.js": "^2.1.3",
    "classnames": "^2.5.1",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "framer-motion": "^11.0.0",
    "lucide-react": "^0.344.0",
    "lz-string": "^1.5.0",
    "pg": "^8.16.3",
    "pixi.js": "^8.14.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^3.7.0",
    "seedrandom": "^3.0.5",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@material-design-icons/svg": "^0.14.15",
    "@types/node": "^25.0.3",
    "@types/react": "^18.2.56",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^5.1.4",
    "vitest": "^2.1.9"
  }
}
