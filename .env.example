# Локальная Postgres строка подключения
# пример:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/mygame
DATABASE_URL=

# Порт локального API
PORT=5174

# Идентификатор слота сохранения (для одного игрока оставь local)
SAVE_ID=local

# DeepSeek AI API ключ для генерации котировок и анализа рынка
# Получить ключ можно на https://platform.deepseek.com/
DEEPSEEK_API_KEY=
