import { useGameStore } from '../../features/gameStore';
import { formatNumber } from '../../core/math/format';
import { PRESTIGE_UPGRADES, canBuyPrestigeUpgrade, getTotalPrestigeBonuses } from '../../core/constants/prestige';
import type { PrestigeUpgradeId } from '../../core/gameTypes';
import { RotateCcw, Zap, Star } from 'lucide-react';
import { useState } from 'react';

type TabType = 'prestige' | 'ascension';

export function PrestigePanel() {
  const { 
    prestige,
    ascension,
    calculatePrestigeGain, 
    performPrestige, 
    buyPrestigeUpgrade,
    toggleFastMode,
    checkAscensionRequirements,
    calculateAscensionGain,
    performAscension,
  } = useGameStore();

  const [activeTab, setActiveTab] = useState<TabType>('prestige');

  const quantumGain = calculatePrestigeGain();
  const totalBonuses = getTotalPrestigeBonuses(prestige);
  const canAscend = checkAscensionRequirements();
  const ascensionGain = calculateAscensionGain();

  // Группируем улучшения по tier
  const upgradesByTier = {
    1: [] as PrestigeUpgradeId[],
    2: [] as PrestigeUpgradeId[],
    3: [] as PrestigeUpgradeId[],
    4: [] as PrestigeUpgradeId[],
  };

  (Object.keys(PRESTIGE_UPGRADES) as PrestigeUpgradeId[]).forEach(id => {
    const upgrade = PRESTIGE_UPGRADES[id];
    upgradesByTier[upgrade.tier].push(id);
  });

  const renderUpgrade = (upgradeId: PrestigeUpgradeId) => {
    const upgrade = PRESTIGE_UPGRADES[upgradeId];
    const currentLevel = prestige.upgrades[upgradeId] || 0;
    const cost = upgrade.cost * (currentLevel + 1);
    const check = canBuyPrestigeUpgrade(upgradeId, prestige);
    const maxed = currentLevel >= upgrade.maxLevel;

    return (
      <div
        key={upgradeId}
        className={`border-2 rounded-lg p-3 ${
          maxed
            ? 'border-green-500 bg-green-900/20'
            : check.canBuy
            ? 'border-blue-500 bg-blue-900/20'
            : 'border-gray-600 bg-gray-800/50 opacity-60'
        }`}
      >
        <div className="flex justify-between items-start mb-2">
          <div className="flex-1">
            <h4 className="text-lg font-bold text-white flex items-center gap-2">
              <span>{upgrade.icon}</span>
              <span>{upgrade.name}</span>
            </h4>
            <p className="text-sm text-gray-300 mt-1">{upgrade.description}</p>
          </div>
          
          {currentLevel > 0 && (
            <div className="ml-2 px-2 py-1 bg-blue-600 rounded text-white text-sm font-bold">
              Lv {currentLevel}/{upgrade.maxLevel}
            </div>
          )}
        </div>

        {/* Эффекты */}
        <div className="mt-2 space-y-1 text-sm">
          {upgrade.effects.productionMultiplier && currentLevel > 0 && (
            <p className="text-green-400">
              📦 +{((Math.pow(upgrade.effects.productionMultiplier, currentLevel) - 1) * 100).toFixed(0)}% производство
            </p>
          )}
          {upgrade.effects.researchMultiplier && currentLevel > 0 && (
            <p className="text-purple-400">
              🔬 +{((Math.pow(upgrade.effects.researchMultiplier, currentLevel) - 1) * 100).toFixed(0)}% исследования
            </p>
          )}
          {upgrade.effects.energyEfficiency && currentLevel > 0 && (
            <p className="text-yellow-400">
              ⚡ -{upgrade.effects.energyEfficiency * currentLevel}% потребление энергии
            </p>
          )}
          {upgrade.effects.buildingCostReduction && currentLevel > 0 && (
            <p className="text-cyan-400">
              🏗️ -{upgrade.effects.buildingCostReduction * currentLevel}% стоимость зданий
            </p>
          )}
          {upgrade.effects.startingCredits && currentLevel > 0 && (
            <p className="text-green-400">
              💰 +{formatNumber(upgrade.effects.startingCredits.mul(currentLevel))} стартовых кредитов
            </p>
          )}
          {upgrade.effects.startingInfluence && currentLevel > 0 && (
            <p className="text-yellow-400">
              👑 +{formatNumber(upgrade.effects.startingInfluence.mul(currentLevel))} стартового влияния
            </p>
          )}
          {upgrade.effects.special && (
            <p className="text-orange-400 italic text-xs">✨ {upgrade.effects.special}</p>
          )}
        </div>

        {/* Стоимость и кнопка */}
        {!maxed && (
          <div className="mt-3">
            {upgrade.prerequisites.length > 0 && (
              <p className="text-xs text-gray-400 mb-1">
                Требует: {upgrade.prerequisites.map(id => PRESTIGE_UPGRADES[id].name).join(', ')}
              </p>
            )}
            
            {check.canBuy ? (
              <button
                onClick={() => buyPrestigeUpgrade(upgradeId)}
                className="w-full px-3 py-2 bg-gradient-to-r from-blue-600 to-purple-600 hover:from-blue-700 hover:to-purple-700 text-white font-bold rounded transition-all text-sm"
              >
                Купить за {cost} QP
              </button>
            ) : (
              <button
                disabled
                className="w-full px-3 py-2 bg-gray-700 text-gray-500 font-bold rounded cursor-not-allowed text-sm"
              >
                {check.reason || 'Недоступно'}
              </button>
            )}
          </div>
        )}

        {maxed && (
          <div className="mt-3 text-center">
            <span className="text-green-400 font-bold text-sm">✓ Максимальный уровень</span>
          </div>
        )}
      </div>
    );
  };

  return (
    <div className="p-6 space-y-6">
      {/* Заголовок и статистика */}
      <div className="cyber-panel p-4">
        <div className="flex items-center justify-between mb-4">
          <h2 className="text-3xl font-bold text-white flex items-center gap-2">
            <RotateCcw className="text-cyan-400" size={32} />
            <span>Престиж</span>
          </h2>
          
          {prestige.upgrades['quantum_fast_mode'] && (
            <button
              onClick={toggleFastMode}
              className={`px-4 py-2 rounded font-bold transition-all ${
                prestige.fastModeEnabled
                  ? 'bg-yellow-600 hover:bg-yellow-700 text-white'
                  : 'bg-gray-600 hover:bg-gray-700 text-gray-300'
              }`}
            >
              <Zap size={18} className="inline mr-1" />
              {prestige.fastModeEnabled ? 'Fast Mode: ON' : 'Fast Mode: OFF'}
            </button>
          )}
        </div>

        <div className="grid grid-cols-2 md:grid-cols-4 gap-4 mb-4">
          <div className="text-center">
            <p className="text-sm text-gray-400">Quantum Points</p>
            <p className="text-2xl font-bold text-cyan-400">{prestige.availableQuantumPoints}</p>
          </div>
          <div className="text-center">
            <p className="text-sm text-gray-400">Всего QP</p>
            <p className="text-2xl font-bold text-purple-400">{prestige.lifetimeQuantumPoints}</p>
          </div>
          <div className="text-center">
            <p className="text-sm text-gray-400">Престижей</p>
            <p className="text-2xl font-bold text-blue-400">{prestige.prestigeCount}</p>
          </div>
          <div className="text-center">
            <p className="text-sm text-gray-400">Концовок</p>
            <p className="text-2xl font-bold text-yellow-400">{prestige.stats.endingsAchieved.length}/4</p>
          </div>
        </div>

        {/* Текущие бонусы */}
        <div className="border-t border-gray-700 pt-4">
          <h3 className="text-lg font-bold text-white mb-2">Активные Бонусы:</h3>
          <div className="grid grid-cols-2 md:grid-cols-4 gap-2 text-sm">
            <div className="text-green-400">
              📦 Производство: x{totalBonuses.productionMultiplier.toFixed(2)}
            </div>
            <div className="text-purple-400">
              🔬 Исследования: x{totalBonuses.researchMultiplier.toFixed(2)}
            </div>
            <div className="text-yellow-400">
              ⚡ Энергия: -{totalBonuses.energyEfficiency.toFixed(0)}%
            </div>
            <div className="text-cyan-400">
              🏗️ Стоимость: -{totalBonuses.buildingCostReduction.toFixed(0)}%
            </div>
            {totalBonuses.gameSpeedMultiplier > 1 && (
              <div className="text-orange-400">
                ⏩ Скорость: x{totalBonuses.gameSpeedMultiplier.toFixed(1)}
              </div>
            )}
            {totalBonuses.resourceRetention > 0 && (
              <div className="text-blue-400">
                💾 Сохранение: {totalBonuses.resourceRetention.toFixed(0)}%
              </div>
            )}
          </div>
        </div>

        {/* Кнопка престижа */}
        <div className="mt-4 p-4 bg-gradient-to-r from-purple-900/50 to-blue-900/50 rounded-lg">
          <p className="text-white text-center mb-2">
            При престиже вы получите: <span className="font-bold text-cyan-400">{quantumGain} Quantum Points</span>
          </p>
          <p className="text-sm text-gray-400 text-center mb-3">
            Прогресс будет сброшен, но престиж-улучшения сохранятся
          </p>
          <button
            onClick={performPrestige}
            disabled={quantumGain <= 0}
            className={`w-full px-6 py-3 rounded-lg font-bold text-lg transition-all ${
              quantumGain > 0
                ? 'bg-gradient-to-r from-purple-600 to-pink-600 hover:from-purple-700 hover:to-pink-700 text-white animate-pulse'
                : 'bg-gray-700 text-gray-500 cursor-not-allowed'
            }`}
          >
            ✨ ПРЕСТИЖ ✨
          </button>
        </div>
      </div>

      {/* Tier 1: Базовые улучшения */}
      <div>
        <h3 className="text-2xl font-bold text-white mb-3">Tier 1: Базовые Улучшения</h3>
        <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
          {upgradesByTier[1].map(renderUpgrade)}
        </div>
      </div>

      {/* Tier 2: Продвинутые */}
      <div>
        <h3 className="text-2xl font-bold text-white mb-3">Tier 2: Продвинутые Улучшения</h3>
        <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
          {upgradesByTier[2].map(renderUpgrade)}
        </div>
      </div>

      {/* Tier 3: Мощные */}
      <div>
        <h3 className="text-2xl font-bold text-white mb-3">Tier 3: Мощные Улучшения</h3>
        <div className="grid grid-cols-1 md:grid-cols-2 gap-3">
          {upgradesByTier[3].map(renderUpgrade)}
        </div>
      </div>

      {/* Tier 4: Ультимативные */}
      <div>
        <h3 className="text-2xl font-bold text-white mb-3">Tier 4: Ультимативные и Награды</h3>
        <div className="grid grid-cols-1 md:grid-cols-2 gap-3">
          {upgradesByTier[4].map(renderUpgrade)}
        </div>
      </div>
    </div>
  );
}
